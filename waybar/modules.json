{
	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": false,
		"format": "{icon}",
		"format-icons": {
		  "active":  "●",
		  "default": "○",
		  "urgent":  "⊙"
		}
	},

	"clock": {
		"format": "{:%H\n%M}",
		"tooltip-format": "{:%A\n%d %B %Y}"
	},

	"battery": {
		"interval": 30,
		"states": { "warning": 30, "critical": 10 },
		"format": "{icon}",
		"format-charging": "󰂄",
		"format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
		"tooltip-format": "{capacity}% — {timeTo}"
	},

	"pulseaudio": {
		"format": "{icon}",
		"format-muted": "󰝟",
		"format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
		"on-click": "pavucontrol",
		"scroll-step": 5
	},

	"tray": {
		"spacing": 5,
		"icon-size": 18
	},

	"custom/network": {
		"format-wifi": "󰤨",
		"format-ethernet": "󰈀",
		"format-disconnected": "󰤭",
		"tooltip": false,
		"on-click": "nm-applet --show-menu"
	}
}
